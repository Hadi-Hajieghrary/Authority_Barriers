# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/

# Editors and OS
.vscode/
.idea/
.DS_Store

# Local reference material (not part of the repository)
Ref/

# Recorded results: summaries, per-trial result tables, kernel/collocation tables, figures and their sidecars,
# reproduction logs and progress files are tracked; raw trial logs (<label>_<k>.json/.npz) and kernel value
# functions are not (several GB; python -m authority_barriers.reproduce regenerates them from fixed seeds).
results/**/*.npz
results/**/*.ckpt
results/core/*/*.json
!results/core/*/results.json
!results/core/e3_kernel/*.json
!results/core/e3_collocation_jobs/*.json
!results/core/figures/**
results/optional/*/*.json
!results/optional/*/results.json
!results/optional/*/results_gentle.json
!results/optional/e3b_kernel6d/*.json
!results/optional/figures/**
results/logs/*
!results/logs/README.md
!results/logs/reproduce_*.log
!results/logs/*.progress
results_smoke/
results_reproduced/

# Derived parameter sets are regenerated by `python -m authority_barriers.theory.params A A1 A2 A_N3 A_mL12`
# but kept for reference
!authority_barriers/configs/derived/

# Documentation and technical report (kept locally)
docs

# LaTeX build files (the paper builds into IEEE_ACC2027/build/)
IEEE_ACC2027/build/
IEEE_ACC2027/*.aux
IEEE_ACC2027/*.log
IEEE_ACC2027/*.out
IEEE_ACC2027/*.fls
IEEE_ACC2027/*.fdb_latexmk
IEEE_ACC2027/*.synctex.gz
IEEE_ACC2027/*.bbl
IEEE_ACC2027/*.blg

